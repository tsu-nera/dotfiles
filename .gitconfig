[core]
	# 日本語ファイル名を \343... にエスケープしない
	quotepath = false
	# MSYS2 (Windows) でも改行を変換しない
	autoCRLF = false
[alias]
	ci = commit -v
	co = checkout
	st = status
	b = branch
[user]
	email = fox10225fox@gmail.com
	name = tsu-nera
[init]
	defaultBranch = main
[url "https://"]
	# GitHub は git:// を廃止済み。古い submodule URL 対策
	insteadOf = git://
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# マシン固有（credential helper 等）は各マシンの ~/.gitconfig.local（未コミット）。
# 相対パスだと symlink 先基準になるので ~ で書く。末尾で読むのでローカル側が上書きできる。
[include]
	path = ~/.gitconfig.local
